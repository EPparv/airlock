+    elif change=='expire':
+        now=g.clock();g.clock=lambda:now+90000
+    else:scope(env,disclose=False)
+    with pytest.raises(Denied):m.decide(p,True)
+
+
+def test_concurrent_proposals_use_revision_checks(env):
